# Filesystem does not support suid or sgid semantics.
#
# pkg:gem/sys-filesystem#lib/sys/unix/sys/filesystem.rb:39
Sys::Filesystem::Stat::NOSUID = T.let(T.unsafe(nil), Integer)

# Filesystem does not truncate file names longer than +name_max+.
#
# pkg:gem/sys-filesystem#lib/sys/unix/sys/filesystem.rb:42
Sys::Filesystem::Stat::NOTRUNC = T.let(T.unsafe(nil), Integer)

# Read-only filesystem
#
# pkg:gem/sys-filesystem#lib/sys/unix/sys/filesystem.rb:36
Sys::Filesystem::Stat::RDONLY = T.let(T.unsafe(nil), Integer)

# pkg:gem/sys-filesystem#lib/sys/filesystem.rb:24
Sys::Filesystem::Stat::ZFS_PROPERTIES = T.let(T.unsafe(nil), Hash)

# pkg:gem/sys-filesystem#lib/sys/unix/sys/filesystem/structs.rb:8
module Sys::Filesystem::Structs; end

# The Iovec struct is used by FreeBSD's nmount(2).
#
# pkg:gem/sys-filesystem#lib/sys/unix/sys/filesystem/structs.rb:261
class Sys::Filesystem::Structs::Iovec < ::FFI::Struct; end

# The Mntent struct represents struct mntent from sys/mount.h on Unix.
#
# pkg:gem/sys-filesystem#lib/sys/unix/sys/filesystem/structs.rb:249
class Sys::Filesystem::Structs::Mntent < ::FFI::Struct; end

# The Statfs struct is a subclass of FFI::Struct that corresponds to a struct statfs.
#
# pkg:gem/sys-filesystem#lib/sys/unix/sys/filesystem/structs.rb:24
class Sys::Filesystem::Structs::Statfs < ::FFI::Struct
  class << self
    private

    # Private method that will determine the layout of the struct on Linux.
    #
    # pkg:gem/sys-filesystem#lib/sys/unix/sys/filesystem/structs.rb:26
    def linux64?; end
  end
end

# FreeBSD 12.0 MNAMELEN from 88 => 1024.
#
# pkg:gem/sys-filesystem#lib/sys/unix/sys/filesystem/structs.rb:38
Sys::Filesystem::Structs::Statfs::MNAMELEN = T.let(T.unsafe(nil), Integer)

# The Statvfs struct represents struct statvfs from sys/statvfs.h.
#
# pkg:gem/sys-filesystem#lib/sys/unix/sys/filesystem/structs.rb:151
class Sys::Filesystem::Structs::Statvfs < ::FFI::Struct
  class << self
    # Private method that will determine the layout of the struct on Linux.
    #
    # pkg:gem/sys-filesystem#lib/sys/unix/sys/filesystem/structs.rb:153
    def linux64?; end
  end
end

# Used by DragonFlyBSD
#
# pkg:gem/sys-filesystem#lib/sys/unix/sys/filesystem/structs.rb:10
class Sys::Filesystem::Structs::UUID < ::FFI::Struct; end

