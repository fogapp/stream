MCP::Client::HTTP::MAX_MESSAGE_BYTES = T.let(T.unsafe(nil), Integer)

# pkg:gem/mcp#lib/mcp/client/http.rb:28
MCP::Client::HTTP::MAX_RECONNECTION_ATTEMPTS = T.let(T.unsafe(nil), Integer)

