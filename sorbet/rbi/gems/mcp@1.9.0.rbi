  # pkg:gem/mcp#lib/mcp/client/oauth/cross_app_access_provider.rb:88
  def jwt_bearer_assertion(audience:, resource:); end

  # pkg:gem/mcp#lib/mcp/client/oauth/cross_app_access_provider.rb:42
  def scope; end

  # pkg:gem/mcp#lib/mcp/client/oauth/cross_app_access_provider.rb:42
  def storage; end

  private

  # pkg:gem/mcp#lib/mcp/client/oauth/cross_app_access_provider.rb:94
