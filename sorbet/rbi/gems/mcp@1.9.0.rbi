  # pkg:gem/mcp#lib/mcp/client/http.rb:981
  def capture_session_info(method, headers, body); end

  # pkg:gem/mcp#lib/mcp/client/http.rb:990
  def clear_session; end

  # pkg:gem/mcp#lib/mcp/client/http.rb:745
