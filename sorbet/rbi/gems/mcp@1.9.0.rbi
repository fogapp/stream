  # pkg:gem/mcp#lib/mcp/server/oauth/introspection_verifier.rb:92
  def introspect(token); end

  # pkg:gem/mcp#lib/mcp/server/oauth/introspection_verifier.rb:142
  def validate_audience!(claims); end
end

