MCP::Server::RequestStateSecurity::DEFAULT_TTL = T.let(T.unsafe(nil), Integer)

# pkg:gem/mcp#lib/mcp/server/request_state_security.rb:33
MCP::Server::RequestStateSecurity::IV_BYTES = T.let(T.unsafe(nil), Integer)

