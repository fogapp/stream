  def send_request(request:); end

  # pkg:gem/mcp#lib/mcp/client/http.rb:253
  def server_info; end

  # pkg:gem/mcp#lib/mcp/client/http.rb:253
  def session_id; end

  # pkg:gem/mcp#lib/mcp/client/http.rb:253
  def url; end

  private

