#!/bin/sh
# Publish main's tree to the public GitHub repo as one new commit, with none
# of the private history. Dry run by default; --push publishes.
#
#   bin/publish-public                     check, and show what would go
#   bin/publish-public --push              publish
#   bin/publish-public --push --accept-findings
#                                          publish past a secret-scan hit a
#                                          person has judged harmless
#
# The commit is built with `git commit-tree`: same files as HEAD, parent is
# public/main, so only that commit's objects are uploaded. Private subjects
# never appear. The very first publish (no public/main yet) is a parentless
# "Initial public release"; every later one is "Sync YYYY-MM-DD". Author and
# committer are the public identity this clone names, never the local git
# identity:
#
#   git config stream.publicAuthorName  '<name>'
#   git config stream.publicAuthorEmail '<email>'
#
# and timestamps are UTC, so they don't carry the local timezone.
#
# A raw `git push public main` would upload the whole history, so this script
# points the `public` remote's push URL at nothing and pushes to the real URL
# itself. That guard is local config, and it is reapplied on every run.
#
#   STREAM_PUBLIC_URL   git@github.com:fogapp/stream.git
#   STREAM_PUBLIC_KEY   ~/.ssh/fog_ed25519   the agent may offer another account's
#                                         key first, so this one is forced
set -eu

PUBLIC_URL="${STREAM_PUBLIC_URL:-git@github.com:fogapp/stream.git}"
PUBLIC_KEY="${STREAM_PUBLIC_KEY:-$HOME/.ssh/fog_ed25519}"
NO_PUSH="push-disabled--use-bin-publish-public"
EMPTY_TREE=4b825dc642cb6eb9a060e54bf8d69288fbee4904

# Credentials that must never reach the public repo. Only lines this sync
# changes are scanned (the whole tree on the first publish).
SECRET_RE='-----BEGIN ([A-Z]+ )?PRIVATE KEY-----|gh[pousr]_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{22,}|AKIA[0-9A-Z]{16}|sk-ant-[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9]{32,}|xox[baprs]-[A-Za-z0-9-]{10,}|AIza[0-9A-Za-z_-]{35}|stream_[0-9a-f]{32,}|streampeer_[A-Za-z0-9]{20,}'
SECRET_FILE_RE='(^|/)(\.env(\..*)?|master\.key|id_(rsa|ed25519|ecdsa)|.*\.(pem|p12|pfx|key|sqlite3|dump))$'
# Files the secret scan is known to hit harmlessly (none yet; add a path here
# only once a person has judged its match harmless). A hit stops the publish.
SECRET_ALLOW_RE='^$'
# Names that are fine despite matching SECRET_FILE_RE.
SECRET_FILE_ALLOW_RE='^\.env\.example$'
# A binary file this large is refused unless it's an image, font or icon.
BINARY_LIMIT=1048576
BINARY_ALLOW_RE='\.(woff2?|ttf|otf|eot|ico|icns|png|svg|jpe?g|gif|webp|avif|mp4|m4v|mov|mkv|webm)$'

PUSH=0
ACCEPT=0
for arg in "$@"; do
  case "$arg" in
    --push) PUSH=1 ;;
    --accept-findings) ACCEPT=1 ;;
    *) echo "usage: bin/publish-public [--push] [--accept-findings]" >&2; exit 2 ;;
  esac
done

die() { echo "publish-public: $*" >&2; exit 1; }

cd "$(dirname "$0")/.."

PUB_NAME=$(git config --get stream.publicAuthorName 2>/dev/null || true)
PUB_EMAIL=$(git config --get stream.publicAuthorEmail 2>/dev/null || true)
if [ -z "$PUB_NAME" ] || [ -z "$PUB_EMAIL" ]; then
  die "no public identity for the sync commit. It must never be your personal git identity, so set the one to publish under, once, in this clone:
  git config stream.publicAuthorName  '<public name>'
  git config stream.publicAuthorEmail '<public email>'
Both are local to this clone and never committed."
fi

# Only what's on origin's main goes public.
[ "$(git branch --show-current)" = main ] || die "not on main"
git diff --quiet HEAD || die "working tree is dirty — commit first"
[ -z "$(git ls-files --others --exclude-standard)" ] || die "untracked files present — commit or ignore them first"
git fetch -q origin
[ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] \
  || die "main and origin/main differ — sync them first"

[ -f "$PUBLIC_KEY" ] || die "no key at $PUBLIC_KEY"
GIT_SSH_COMMAND="ssh -i $PUBLIC_KEY -o IdentitiesOnly=yes"
export GIT_SSH_COMMAND

git remote get-url public >/dev/null 2>&1 || git remote add public "$PUBLIC_URL"
git remote set-url public "$PUBLIC_URL"
git remote set-url --push public "$NO_PUSH"
git ls-remote --exit-code public >/dev/null 2>&1 || [ $? -eq 2 ] \
  || die "can't reach $PUBLIC_URL — does the repo exist, and is $PUBLIC_KEY a key for it?"
git fetch -q public 2>/dev/null || true

if git rev-parse -q --verify refs/remotes/public/main >/dev/null; then
  FIRST=0
  BASE=public/main
  if git merge-base HEAD public/main >/dev/null; then
    die "public/main shares history with main — stop and investigate"
  fi
  # The sync replaces the whole tree, so a commit made on GitHub would be
  # undone by the next one.
  OUTSIDE=$(git log --format=%s public/main | grep -Ev '^(Initial public release|Sync [0-9]{4}-[0-9]{2}-[0-9]{2})$' || true)
  [ -z "$OUTSIDE" ] || die "public/main has commits this script didn't make — bring them into main first:
$OUTSIDE"
  if [ "$(git rev-parse 'HEAD^{tree}')" = "$(git rev-parse 'public/main^{tree}')" ]; then
    echo "public main already matches main — nothing to publish"
    exit 0
  fi
  echo "==> changes since the last publish"
  git diff --stat=100 public/main HEAD | tail -25
else
  # The repo exists but is empty: this is the first publish, of the whole tree.
  FIRST=1
  BASE=$EMPTY_TREE
  echo "==> first publish: the whole tree ($(git ls-files | wc -l | tr -d ' ') files)"
fi

# --text: binary files are scanned too (a key baked into a built asset).
# Renames and copies count as new files for the name check: moving
# config.sample to .env is adding a .env.
FINDINGS=$(git -c core.quotePath=false diff --text -G"$SECRET_RE" --name-only "$BASE" HEAD | grep -Ev "$SECRET_ALLOW_RE" || true)
NEWFILES=$(git -c core.quotePath=false diff -M -C --diff-filter=ACR --name-only "$BASE" HEAD | grep -E "$SECRET_FILE_RE" | grep -Ev "$SECRET_FILE_ALLOW_RE" || true)

BIG=""
CHANGED=$(git -c core.quotePath=false diff -M -C --diff-filter=ACMR --name-only "$BASE" HEAD)
while IFS= read -r f; do
  [ -n "$f" ] || continue
  size=$(git cat-file -s "HEAD:$f" 2>/dev/null || echo 0)
  [ "$size" -gt "$BINARY_LIMIT" ] || continue
  nuls=$(git cat-file -p "HEAD:$f" | head -c 8000 | tr -dc '\000' | wc -c | tr -d ' ')
  [ "$nuls" -gt 0 ] || continue
  printf '%s\n' "$f" | grep -Eq "$BINARY_ALLOW_RE" && continue
  BIG="$BIG
    $f ($size bytes)"
done <<EOF
$CHANGED
EOF
[ -z "$BIG" ] || die "binary files over $BINARY_LIMIT bytes that aren't images, fonts, icons or media fixtures:$BIG
Remove them from the commit, or, if one truly belongs in the public tree, add its path to BINARY_ALLOW_RE in this script."

if [ -n "$FINDINGS$NEWFILES" ]; then
  echo "==> secret scan hit these files (matches not printed):" >&2
  printf '%s\n' "$FINDINGS" "$NEWFILES" | sed '/^$/d' | sort -u | sed 's/^/    /' >&2
  [ "$ACCEPT" = 1 ] || die "not publishing — inspect them, then pass --accept-findings if harmless"
  echo "==> accepted by --accept-findings" >&2
fi

NOW="$(date -u +%s) +0000"
if [ "$FIRST" = 1 ]; then
  MSG="Initial public release"
  set --
else
  MSG="Sync $(date -u +%Y-%m-%d)"
  set -- -p public/main
fi
SHA=$(GIT_AUTHOR_NAME="$PUB_NAME" GIT_AUTHOR_EMAIL="$PUB_EMAIL" GIT_AUTHOR_DATE="$NOW" \
  GIT_COMMITTER_NAME="$PUB_NAME" GIT_COMMITTER_EMAIL="$PUB_EMAIL" GIT_COMMITTER_DATE="$NOW" \
  git commit-tree 'HEAD^{tree}' "$@" -m "$MSG")

# The commit must not reach any private commit: parentless, or public/main only.
PARENTS=$(git rev-list --parents -n 1 "$SHA" | cut -s -d' ' -f2-)
if [ "$FIRST" = 1 ]; then
  [ -z "$PARENTS" ] || die "built commit has a parent — refusing"
else
  [ "$PARENTS" = "$(git rev-parse public/main)" ] || die "built commit's parent isn't public/main — refusing"
fi

if [ "$PUSH" = 0 ]; then
  git push --dry-run --no-follow-tags "$PUBLIC_URL" "$SHA:refs/heads/main"
  echo "dry run ok — would publish \"$MSG\" as $SHA, by $PUB_NAME <$PUB_EMAIL>; pass --push to publish"
  exit 0
fi

# Never forced: if public moved since the fetch, this fails rather than losing it.
git push --no-follow-tags "$PUBLIC_URL" "$SHA:refs/heads/main"
git fetch -q public

[ "$(git rev-parse public/main)" = "$SHA" ] || die "pushed, but public/main is not $SHA"
[ "$(git rev-parse 'public/main^{tree}')" = "$(git rev-parse 'HEAD^{tree}')" ] \
  || die "pushed, but public/main's files differ from HEAD"
echo "published \"$MSG\" as $SHA"
