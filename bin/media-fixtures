#!/usr/bin/env bash
# Regenerates spec/fixtures/media — the media fixture corpus (PROPOSAL §8.4).
#
# Tiny (2 s, 160x90) and committed. Not byte-deterministic (x264 threads,
# Matroska UIDs), so regenerate only when adding a case — the spec checks
# stream facts, never bytes. One file per case the
# decision engine, the prober and the subtitle pipeline must handle; the
# expected facts live beside them in manifest.json and are checked by
# spec/media/fixture_corpus_spec.rb. Needs ffmpeg 7 (jellyfin-ffmpeg in the
# images); run it inside the dev image if your local ffmpeg is older:
#
#   docker run --rm -v "$PWD:/rails" stream-web bin/media-fixtures
#
# Not covered here, because ffmpeg cannot encode them from scratch: image
# subtitles (PGS, VobSub — encoders need bitmap input) and Dolby Vision.
# Those get small real samples when Phase 2's subtitle pipeline needs them.
set -euo pipefail
cd "$(dirname "$0")/.."
OUT=spec/fixtures/media
mkdir -p "$OUT"
rm -f "$OUT"/*.mkv "$OUT"/*.mp4 "$OUT"/*.webm "$OUT"/*.ts "$OUT"/*.avi

export SVT_LOG=1 # SVT-AV1: errors only
FF=(ffmpeg -hide_banner -nostdin -loglevel error -y -fflags +bitexact)
V=(-f lavfi -i "testsrc2=size=160x90:rate=24:duration=2")
A=(-f lavfi -i "sine=frequency=440:sample_rate=48000:duration=2")
SIX="pan=5.1|c0=c0|c1=c0|c2=c0|c3=c0|c4=c0|c5=c0"
BITEXACT=(-flags:v +bitexact -flags:a +bitexact -map_metadata -1)
GOP=(-g 12)

sub_srt=$(mktemp); sub_ass=$(mktemp)
trap 'rm -f "$sub_srt" "$sub_ass"' EXIT
printf '1\n00:00:00,200 --> 00:00:01,500\nHello from the corpus.\n' > "$sub_srt"
cat > "$sub_ass" <<'ASS'
[Script Info]
ScriptType: v4.00+
PlayResX: 160
PlayResY: 90

[V4+ Styles]
Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding
Style: Default,Arial,12,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1,0,2,10,10,10,1

[Events]
Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text
Dialogue: 0,0:00:00.20,0:00:01.50,Default,,0,0,0,,{\an8}Styled {\i1}ASS{\i0} line
ASS

# 1. The baseline every browser direct-plays.
"${FF[@]}" "${V[@]}" "${A[@]}" -c:v libx264 -preset veryfast -profile:v high -pix_fmt yuv420p "${GOP[@]}" \
  -c:a aac -b:a 64k "${BITEXACT[@]}" -movflags +faststart "$OUT/h264_aac.mp4"
# 2. MKV with an AC-3 5.1 second track and text subtitles: remux (Safari) + audio transcode (Chrome) + sidecar-free subs.
"${FF[@]}" "${V[@]}" "${A[@]}" -i "$sub_srt" -i "$sub_ass" -filter_complex "[1:a]asplit[a0][a1];[a1]$SIX[a51]" \
  -map 0:v -map "[a0]" -map "[a51]" -map 2 -map 3 \
  -c:v libx264 -preset veryfast -pix_fmt yuv420p "${GOP[@]}" -c:a:0 aac -b:a:0 64k -c:a:1 ac3 -b:a:1 192k -c:s:0 srt -c:s:1 ass \
  -metadata:s:a:0 language=eng -metadata:s:a:1 language=eng -metadata:s:a:1 title="Surround 5.1" \
  -metadata:s:s:0 language=eng -metadata:s:s:1 language=jpn -disposition:s:1 forced "${BITEXACT[@]}" "$OUT/h264_aac_ac3_subs.mkv"
# 3. HEVC Main10 tagged HDR10 (PQ/BT.2020): direct on HDR-capable Safari/Chrome, tone-map elsewhere.
"${FF[@]}" "${V[@]}" "${A[@]}" -c:v libx265 -preset ultrafast -pix_fmt yuv420p10le \
  -x265-params "log-level=error:pools=none:frame-threads=1:keyint=12:colorprim=bt2020:transfer=smpte2084:colormatrix=bt2020nc:hdr10=1:max-cll=1000,400:master-display=G(13250,34500)B(7500,3000)R(34000,16000)WP(15635,16450)L(10000000,1)" \
  -color_primaries bt2020 -color_trc smpte2084 -colorspace bt2020nc -c:a aac -b:a 64k "${BITEXACT[@]}" "$OUT/hevc_main10_hdr10.mkv"
# 4. AV1 + Opus in WebM.
"${FF[@]}" "${V[@]}" "${A[@]}" -c:v libsvtav1 -preset 12 -pix_fmt yuv420p "${GOP[@]}" -c:a libopus -b:a 48k "${BITEXACT[@]}" "$OUT/av1_opus.webm"
# 5. VP9 profile 0 + Opus.
"${FF[@]}" "${V[@]}" "${A[@]}" -c:v libvpx-vp9 -deadline realtime -cpu-used 8 -pix_fmt yuv420p "${GOP[@]}" -c:a libopus -b:a 48k "${BITEXACT[@]}" "$OUT/vp9_opus.webm"
# 6. MPEG-2 + MP2 in MPEG-TS: nothing plays it — the video-transcode rung.
"${FF[@]}" "${V[@]}" "${A[@]}" -c:v mpeg2video -q:v 4 "${GOP[@]}" -c:a mp2 -b:a 128k "${BITEXACT[@]}" "$OUT/mpeg2_mp2.ts"
# 7. H.264 High 10 (Hi10P, the anime case): no browser decodes it.
"${FF[@]}" "${V[@]}" "${A[@]}" -c:v libx264 -preset veryfast -profile:v high10 -pix_fmt yuv420p10le "${GOP[@]}" -c:a aac -b:a 64k "${BITEXACT[@]}" "$OUT/h264_hi10p.mkv"
# 8. DTS 5.1 and TrueHD 5.1: audio no browser decodes.
"${FF[@]}" "${V[@]}" "${A[@]}" -filter_complex "[1:a]$SIX[a]" -map 0:v -map "[a]" -c:v libx264 -preset veryfast -pix_fmt yuv420p "${GOP[@]}" \
  -c:a dca -strict -2 -b:a 768k "${BITEXACT[@]}" "$OUT/h264_dts.mkv"
"${FF[@]}" "${V[@]}" "${A[@]}" -filter_complex "[1:a]$SIX[a]" -map 0:v -map "[a]" -c:v libx264 -preset veryfast -pix_fmt yuv420p "${GOP[@]}" \
  -c:a truehd -strict -2 "${BITEXACT[@]}" "$OUT/h264_truehd.mkv"
# 9. FLAC stereo: plays in Chrome/Firefox fMP4, not everywhere.
"${FF[@]}" "${V[@]}" "${A[@]}" -c:v libx264 -preset veryfast -pix_fmt yuv420p "${GOP[@]}" -c:a flac "${BITEXACT[@]}" "$OUT/h264_flac.mkv"
# 10. mov_text subtitles inside MP4.
"${FF[@]}" "${V[@]}" "${A[@]}" -i "$sub_srt" -map 0:v -map 1:a -map 2 -c:v libx264 -preset veryfast -pix_fmt yuv420p "${GOP[@]}" \
  -c:a aac -b:a 64k -c:s mov_text -metadata:s:s:0 language=eng "${BITEXACT[@]}" "$OUT/h264_aac_movtext.mp4"
# 11. Truncated: the prober must mark it broken, not crash.
head -c 6000 "$OUT/h264_aac_ac3_subs.mkv" > "$OUT/truncated.mkv"

ls -la "$OUT" | awk 'NR>1 {printf "%8d  %s\n", $5, $9}'
