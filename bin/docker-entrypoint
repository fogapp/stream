#!/bin/bash -e

# Restore-on-boot guard (fog-backup/1 and /2, fog:docs/backup-contract.md): when an
# artifact is staged and armed — the setup wizard's restore door arms one and
# exits so the container restarts through here — restore it before serving.
# Every process (server, worker, streamer) routes through this entrypoint;
# the Postgres advisory lock inside the task makes exactly one perform the
# restore while the siblings wait, then find the marker gone and boot
# normally. A failed restore exits nonzero on purpose: refusing to serve
# beats booting half-restored.
if [ -f /rails/storage/fog/restore/pending.json ]; then
  echo "fog: staged restore detected — restoring before boot"
  ./bin/rails fog:restore_if_staged
fi

exec "$@"
